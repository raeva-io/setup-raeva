{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [{ "matchManagers": ["maven"], "groupName": "maven" }],
  "postUpgradeTasks": {
    "commands": ["raeva sync"],
    "fileFilters": ["raeva.lock"],
    "executionMode": "branch"
  }
}
