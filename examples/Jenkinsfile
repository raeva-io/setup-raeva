// Jenkinsfile: check raeva.lock, then run the unchanged Maven build.
//
// RAEVA_SHA256 is the SHA-256 that the release's sha256.sum gives for
// RAEVA_ARCHIVE (see "Other CI systems" in the setup-raeva README). Pinning
// it here means a replaced release asset fails the build. The agent needs
// curl, tar, sha256sum, and a JDK listed in [lock] jdks, or the JDK the lock
// was written with, as JAVA_HOME. raeva and its store stay in
// $WORKSPACE_TMP, outside the checkout that build checks such as Apache RAT
// scan, one store per raeva version, since an older raeva can refuse a store
// that a newer one upgraded; delete the directory of a version no longer
// used.
pipeline {
  agent any
  environment {
    RAEVA_VERSION = '0.5.3'
    RAEVA_ARCHIVE = 'raeva-x86_64-unknown-linux-musl.tar.gz'
    RAEVA_SHA256 = '<sha256 from sha256.sum>'
  }
  stages {
    stage('raeva.lock') {
      steps {
        // Single quotes: the shell, not Groovy, expands the variables.
        sh '''
          set -eu
          dir="$WORKSPACE_TMP/raeva"
          export RAEVA_HOME="$dir/home-$RAEVA_VERSION"
          mkdir -p "$dir/bin"
          curl --proto '=https' --tlsv1.2 -fsSL -o "$dir/raeva.tar.gz" \
            "https://github.com/raeva-io/raeva/releases/download/v${RAEVA_VERSION}/${RAEVA_ARCHIVE}"
          echo "${RAEVA_SHA256}  $dir/raeva.tar.gz" | sha256sum -c -
          tar -xzf "$dir/raeva.tar.gz" -C "$dir/bin" --strip-components=1 --wildcards '*/raeva'
          "$dir/bin/raeva" --version
          "$dir/bin/raeva" sync --frozen
        '''
      }
    }
    stage('Build') {
      steps {
        sh 'mvn --batch-mode verify'
      }
    }
  }
}
